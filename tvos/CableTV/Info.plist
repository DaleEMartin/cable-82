<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The station serves plain HTTP on the LAN. NSAllowsLocalNetworking permits that for
	     IP addresses, .local names, and single-label host names, and nothing else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CableTV plays the channels served by your CABLE 82 station on your home network.</string>
</dict>
</plist>
